# Normalise line endings.
#
# This repository is run under Linux (Docker / Singularity / HPC). CRLF line
# endings break shell scripts at the shebang ("#!/bin/bash\r" -> bad interpreter)
# and can break Snakemake rules and conda env files. Store and check out LF
# everywhere, regardless of the contributor's platform.

* text=auto eol=lf

# Interpreted / executed files - must be LF
*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.smk       text eol=lf
*.pl        text eol=lf
*.R         text eol=lf
Snakefile   text eol=lf
Dockerfile  text eol=lf
*.def       text eol=lf

# Config / data text
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.tsv       text eol=lf
*.csv       text eol=lf
*.bed       text eol=lf
*.gtf       text eol=lf
*.fa        text eol=lf
*.fasta     text eol=lf

# Binary - never convert
*.gz        binary
*.bz2       binary
*.zip       binary
*.bam       binary
*.bai       binary
*.png       binary
*.jpg       binary
*.pdf       binary
*.sif       binary
